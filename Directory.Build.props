<Project>

    <PropertyGroup>
        <Authors>axolmain</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/axolmain/AxoParse</PackageProjectUrl>
        <RepositoryUrl>https://github.com/axolmain/AxoParse</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <!-- Source Link ships with the .NET SDK (8+), GitHub included, so no Microsoft.SourceLink.GitHub reference -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

</Project>
