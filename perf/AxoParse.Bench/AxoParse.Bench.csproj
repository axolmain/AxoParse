<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <!-- Never load ICU: the CLI does no culture-sensitive work (~0.3 ms startup, ~0.5 ms at 8 threads on an M4) -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- NativeAOT codegen tuned for speed over size, like Rust's release opt-level 3 (~4% single-threaded) -->
        <OptimizationPreference>Speed</OptimizationPreference>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\AxoParse.Evtx\AxoParse.Evtx.csproj"/>
    </ItemGroup>

</Project>
